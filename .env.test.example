# ══════════════════════════════════════════════════════════════
# Land Intelligence — TEST environment
# Copy to .env  (root)  and to server/.env when running the test suite.
#
# Tests are unit/integration over the Fastify app; they pass without a
# database (graceful degradation). These variables keep them deterministic.
# ══════════════════════════════════════════════════════════════

NODE_ENV=test
LOG_LEVEL=silent

PORT=3001
HOST=127.0.0.1

APP_URL=http://localhost:8787
API_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Provide valid URLs pointing to a disposable local database.
DATABASE_URL=postgresql://land_intel:land_intel_dev_2024@localhost:5433/land_intelligence_test
REDIS_URL=redis://localhost:6380

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage/test

# OpenStreetMap / Nominatim (not used in tests; safe defaults)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=LandIntelligence/0.1 (test)

SCOUT_DB_PATH=./data/scout.db

SCOUT_PORT=8787