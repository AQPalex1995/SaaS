# ══════════════════════════════════════════════════════════════
# Land Intelligence — Environment Configuration
#
# Copy the appropriate template to your active file:
#   development -> .env.development.example  (used when NODE_ENV=development)
#   test        -> .env.test.example
#   production  -> .env.production.example
#
# NEVER commit real .env files or real secrets to git.
# NEVER place secrets in Dockerfiles, docker-compose, code or logs.
# The application only receives secrets through environment variables
# or secure configuration mechanisms (future: Google Secret Manager).
#
# The stack is cloud-agnostic: PostgreSQL, Redis and storage are reached
# exclusively through DATABASE_URL / REDIS_URL / STORAGE_* — they never
# assume localhost, Docker, Cloud SQL or any specific provider.
# ══════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
LOG_LEVEL=info

# ── HTTP Server ──────────────────────────────────────────────
# Cloud Run injects PORT (default 8080). Local dev uses API_PORT.
PORT=3001
# Cloud Run requires HOST=0.0.0.0; local dev defaults to 127.0.0.1.
HOST=127.0.0.1

# ── Public URLs ──────────────────────────────────────────────
# APP_URL: where this UI is served (Scout panel in dev).  API_URL: base URL
# consumable by browsers/clients (used by the panel's Property Drawer).
APP_URL=http://localhost:8787
API_URL=http://127.0.0.1:3001

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allow-list. If empty, any origin is allowed (dev only).
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# ── Core Database (PostgreSQL + PostGIS) ─────────────────────
# Local: port 5433 (NEVER 5432 — CAST ERP owns it).
DATABASE_URL=postgresql://land_intel:land_intel_dev_2024@localhost:5433/land_intelligence

# ── Redis (BullMQ queues) ────────────────────────────────────
# Local: port 6380 (NEVER 6379 — CAST ERP owns it).
REDIS_URL=redis://localhost:6380

# ── Storage (abstraction, cloud-agnostic) ────────────────────
# Supported provider: "local" (LocalStorageProvider). Future: "gcs".
STORAGE_PROVIDER=local
STORAGE_BUCKET=land-intel-local
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# Directory used by LocalStorageProvider (relative to the server cwd).
STORAGE_LOCAL_DIR=./data/storage

# ── Legacy Scout Server ──────────────────────────────────────
SCOUT_PORT=8787

# ── OpenStreetMap / Nominatim (rate-limited 1 req/s) ─────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=LandIntelligence/0.1 (land-intel-dev; +http://localhost:3001)

# REM@JU — superficie publica (Fase 4/T4.2): solo lectura sin login ni CAPTCHA
REMAJU_HOME_URL=https://remaju.pj.gob.pe/remaju/index.xhtml
REMAJU_USER_AGENT=LandIntelligence/0.1 (land-intel-dev; public remate info reader; +http://localhost:3001)

# ── Legacy Scout SQLite (for sync:sqlite and on-the-fly research) ──
SCOUT_DB_PATH=./data/scout.db

# ── Future Google Cloud context (OPTIONAL, never required) ───
# These are purely informational today. No cloud dependency is introduced.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# ── Future External Sources (DO NOT fill with real credentials) ─
# SUNARP_API_URL=
# SUNARP_API_KEY=
# GOOGLE_MAPS_API_KEY=