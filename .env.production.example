# ══════════════════════════════════════════════════════════════
# Land Intelligence — PRODUCTION environment (future)
#
# THIS TEMPLATE CONTAINS NO SECRETS. Copy to .env and fill real
# values ONLY via environment variables injected by your deployment
# platform (Cloud Run, Cloud SQL, Secret Manager, etc.).
#
# The application is cloud-agnostic: the same image runs against
# Docker Compose locally or Cloud Run + Cloud SQL in production.
# ══════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info

# Cloud Run injects PORT (default 8080). HOST MUST be 0.0.0.0.
PORT=8080
HOST=0.0.0.0

APP_URL=https://YOUR_APP_DOMAIN.example
API_URL=https://YOUR_APP_DOMAIN.example

# Restrict CORS to your real origins.
CORS_ORIGINS=https://YOUR_APP_DOMAIN.example

# ── Cloud SQL / managed PostgreSQL + PostGIS ─────────────────
# Fill via Secret Manager. Example (never a real value):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/land_intelligence
DATABASE_URL=

# ── Managed Redis ────────────────────────────────────────────
REDIS_URL=

# ── Storage ──────────────────────────────────────────────────
# Future "gcs" for Google Cloud Storage. Do not set until implemented.
STORAGE_PROVIDER=local
STORAGE_BUCKET=land-intel-prod
# STORAGE_ENDPOINT=
# STORAGE_REGION=

# ── Legacy Scout is LOCAL-ONLY and is never deployed ─────────
SCOUT_PORT=8787

# ── OpenStreetMap / Nominatim (rate-limited 1 req/s) ─────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=LandIntelligence/0.1 (production)

# ── Legacy Scout SQLite (LOCAL-ONLY; never in cloud) ─────────
# SCOUT_DB_PATH=/data/scout.db

# ── Google Cloud context (optional, informational) ───────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=