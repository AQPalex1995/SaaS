# ══════════════════════════════════════════════════════════════
# Land Intelligence — DEVELOPMENT environment
# Copy to .env  (root)  and to server/.env
# ══════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=info

PORT=3001
HOST=127.0.0.1

APP_URL=http://localhost:8787
API_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Local stack via Docker Compose: PostgreSQL 5433, Redis 6380.
DATABASE_URL=postgresql://land_intel:land_intel_dev_2024@localhost:5433/land_intelligence
REDIS_URL=redis://localhost:6380

STORAGE_PROVIDER=local
STORAGE_BUCKET=land-intel-local
STORAGE_LOCAL_DIR=./data/storage

# OpenStreetMap / Nominatim (rate-limited 1 req/s)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=LandIntelligence/0.1 (land-intel-dev; +http://localhost:3001)

# Legacy Scout SQLite (for sync:sqlite and on-the-fly research creation)
SCOUT_DB_PATH=./data/scout.db

SCOUT_PORT=8787

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=